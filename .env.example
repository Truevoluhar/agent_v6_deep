POSTGRES_USER=deepagents
POSTGRES_PASSWORD=deepagents
POSTGRES_DB=deepagents
DATABASE_URL=postgresql://deepagents:deepagents@postgres:5432/deepagents
AGENT_DATA_ROOT=/data

ACTIVE_PROVIDER=openai
OPENAI_API_KEY=dummy-value
VLLM_BASE_URL=http://host.docker.internal:8000/v1
VLLM_API_KEY=dummy
VLLM_TLS_VERIFY=true
VLLM_CA_FILE=
VLLM_CA_PATH=
VLLM_CLIENT_CERT_FILE=
VLLM_CLIENT_KEY_FILE=
VLLM_CLIENT_KEY_PASSWORD=

AGENT_SYSTEM_PROMPT=You are a reliable engineering agent. Prefer careful inspection, create durable artifacts in the workspace, explain assumptions clearly, and use the available skills when they fit the task.
AGENT_ENABLED_TOOLKITS=filesystem,shell
AGENT_RECURSION_LIMIT=120
AGENT_SHELL_TIMEOUT_SECONDS=120
CLIENT_DEFAULT_UPLOAD_DIR=uploads
AGENT_API_FALLBACK_URLS=http://host.docker.internal:8081
WORKSPACE_API_FALLBACK_URLS=http://host.docker.internal:8090
